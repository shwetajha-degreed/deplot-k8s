services:
  - hostname: {{SLUG}}-postgres
    type: postgresql@16
    mode: NON_HA
    priority: 5

  - hostname: {{SLUG}}-cache
    type: valkey@7
    mode: NON_HA
    priority: 4

  - hostname: {{SLUG}}-search
    type: typesense@30
    mode: NON_HA
    priority: 4

  - hostname: {{SLUG}}-api
    type: {{API_RUNTIME}}
    mode: NON_HA
    enableSubdomainAccess: true
    priority: 2
    buildFromGit: {{REPO_URL}}
    zeropsSetup: api
    zeropsYaml:
      zerops:
        - setup: api
          build:
            base: {{API_RUNTIME}}
            buildCommands:
              - {{API_BUILD_CMD}}
            deployFiles:
              - {{API_DEPLOY_PATH}}
            cache:
              - {{API_CACHE_PATH}}
          deploy:
            readinessCheck:
              httpGet:
                port: 8000
                path: {{API_HEALTH_PATH}}
          run:
            base: {{API_RUNTIME}}
            envVariables:
              DATABASE_URL: postgresql://${{SLUG}}-postgres_hostname
              REDIS_URL: redis://${{SLUG}}-cache_hostname:6379
              TYPESENSE_HOST: ${{SLUG}}-search_hostname
              TYPESENSE_PORT: "8108"
              TYPESENSE_PROTOCOL: http
              CORS_ORIGINS: https://${{SLUG}}-web_hostname
            ports:
              - port: 8000
                httpSupport: true
            start: {{API_START_CMD}}

  - hostname: {{SLUG}}-web
    type: {{WEB_RUNTIME}}
    mode: NON_HA
    enableSubdomainAccess: true
    priority: 1
    buildFromGit: {{REPO_URL}}
    zeropsSetup: web
    envVariables:
      NEXT_PUBLIC_API_URL: https://${{SLUG}}-api_hostname/api/v1
    zeropsYaml:
      zerops:
        - setup: web
          build:
            base: {{WEB_RUNTIME}}
            envVariables:
              NEXT_PUBLIC_API_URL: https://${{SLUG}}-api_hostname/api/v1
            buildCommands:
              - {{WEB_BUILD_CMD}}
            deployFiles:
              - {{WEB_DEPLOY_PATH}}
            cache:
              - {{WEB_CACHE_PATH}}
          deploy:
            readinessCheck:
              httpGet:
                port: 3000
                path: /
          run:
            base: {{WEB_RUNTIME}}
            envVariables:
              NODE_ENV: production
              NEXT_PUBLIC_API_URL: https://${{SLUG}}-api_hostname/api/v1
            ports:
              - port: 3000
                httpSupport: true
            start: npm start
