project:
  name: deplot-target-{{FRAMEWORK}}
  description: "Generated by Deplot AI"
  corePackage: LIGHT

services:
  - hostname: postgres
    type: postgresql@16
    mode: NON_HA
    priority: 2

  - hostname: api
    type: {{RUNTIME}}
    mode: NON_HA
    enableSubdomainAccess: true
    priority: 1
    buildFromGit: {{REPO_URL}}
    zeropsSetup: api
    zeropsYaml:
      zerops:
        - setup: api
          build:
            base: {{RUNTIME}}
            buildCommands:
              - pip install -r requirements.txt
            deployFiles: ./
          run:
            base: {{RUNTIME}}
            ports:
              - port: 8000
                httpSupport: true
            readiness:
              http:
                path: /health
                statusCode: 200
            start: uvicorn main:app --host 0.0.0.0 --port 8000
