project:
  name: deplot-target-{{FRAMEWORK}}
  description: "Generated by Deplot AI"
  corePackage: LIGHT

services:
  - hostname: postgres
    type: postgresql@16
    mode: NON_HA
    priority: 2

  - hostname: api
    type: {{RUNTIME}}
    mode: NON_HA
    enableSubdomainAccess: true
    priority: 1
    buildFromGit: {{REPO_URL}}
    zeropsSetup: app
    zeropsYaml:
      zerops:
        - setup: app
          build:
            base: {{RUNTIME}}
            buildCommands:
              - npm ci
              - npm run build
            deployFiles: ./
            cache: node_modules
          run:
            base: {{RUNTIME}}
            ports:
              - port: 3000
                httpSupport: true
            readiness:
              http:
                path: /api/health
                statusCode: 200
            start: npm start
