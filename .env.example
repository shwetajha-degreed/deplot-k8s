# Deplot-K8s — copy to .env

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GITHUB_TOKEN=

# Azure / AKS target platform
AKS_CLUSTER_NAME=DGCUSUSSBXAKS01
ACR_REGISTRY=dgscucorecr01.azurecr.io
AZURE_WORKLOAD_IDENTITY_CLIENT_ID=
BASE_DOMAIN=internal.sbx.degreed.com

# Local dev only — leave blank when running in-cluster (uses ServiceAccount token)
KUBECONFIG_PATH=

DATABASE_URL=postgresql+asyncpg://deplot:deplot@localhost:5432/deplot
REDIS_URL=redis://localhost:6379/0

DEBUG=true
DEMO_MODE_ENABLED=true
AI_AGENTS_ENABLED=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
