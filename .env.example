# Deplot — copy to .env

GEMINI_API_KEY=
GITHUB_TOKEN=

# Zerops REST API: https://api.app-prg1.zerops.io/api/rest/public
# Token: Zerops GUI → Settings → Access Token Management → Generate new token
#
# Local .env may use ZEROPS_* names. On Zerops GUI, custom keys cannot start with
# ZEROPS_ — set these instead on the api service:
#   DEPLOT_API_TOKEN, PLATFORM_PROJECT_ID, DEPLOY_PROJECT_ID, GEMINI_API_KEY
ZEROPS_API_TOKEN=

# Deplot platform project (hosts web, api, postgres, cache)
ZEROPS_PROJECT_ID=

# Separate project for wizard deploy testing — run scripts/setup-deploy-sandbox.*
ZEROPS_DEPLOY_PROJECT_ID=

# Project core tier for plan cost estimates: lightweight (free) or serious ($10/mo)
# Local .env: ZEROPS_PROJECT_CORE=serious
# Zerops api service env (ZEROPS_* forbidden in GUI): DEPLOT_PROJECT_CORE=serious
ZEROPS_PROJECT_CORE=lightweight

DATABASE_URL=postgresql+asyncpg://deplot:deplot@localhost:5432/deplot
REDIS_URL=redis://localhost:6379/0

DEBUG=true
DEMO_MODE_ENABLED=true
AI_AGENTS_ENABLED=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
